[Unit]
Description=XBet Telegram Bot & Cashier Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/xbet-bot
Environment=NODE_ENV=production
EnvironmentFile=/opt/xbet-bot/.env
ExecStart=/usr/bin/node /opt/xbet-bot/dist/server.cjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xbet-bot

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
