{
  "name": "xbet-telegram-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "pm2:start": "pm2 start dist/server.cjs --name xbet-bot",
    "pm2:stop": "pm2 stop xbet-bot",
    "pm2:restart": "pm2 restart xbet-bot",
    "pm2:logs": "pm2 logs xbet-bot",
    "pm2:status": "pm2 status",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "deploy:cf": "bash deploy.sh",
    "deploy:cf:ci": "CI=true bash deploy.sh",
    "deploy:cf:dry": "CI=true SKIP_MIGRATION=1 SKIP_HEALTHCHECK=1 bash deploy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@grammyjs/conversations": "^2.0.0",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0",
    "wrangler": "4.131.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp@0.33.5": true,
    "workerd@1.20260910.1": true
  }
}
