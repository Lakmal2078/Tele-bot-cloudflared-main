# ==============================================================================
# Fast xBet Cash Telegram Bot & Cloudflare Worker Configuration
# Copy this file to .env for local Node.js development or set these as Cloudflare Secrets.
# NEVER commit real credentials or private keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Core Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Bot token obtained from Telegram @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated Telegram User IDs of system administrators
ADMIN_IDS=123456789,987654321

# Minimum 16-character cryptographic secret for Telegram webhook authentication
WEBHOOK_SECRET=replace_with_min_16_char_secret_token_here

# Minimum 24-character cryptographic secret for private operational API endpoints (/api/*)
ADMIN_API_SECRET=replace_with_min_24_char_admin_api_secret_here

# ------------------------------------------------------------------------------
# 2. Server & Runtime Options
# ------------------------------------------------------------------------------
# Port for local Node.js HTTP server (Default: 3000)
PORT=3000

# Bot execution mode: "webhook" (default) or "polling"
BOT_MODE=webhook

# Set to "true" to force long polling mode during local offline development
USE_POLLING=false

# SQLite database file path for local Node.js mode (defaults to ./data/bot.db)
DB_PATH=./data/bot.db

# ------------------------------------------------------------------------------
# 3. Community Channels & Affiliate Links
# ------------------------------------------------------------------------------
# Public Telegram announcement channel username and invite URL
CHANNEL_USERNAME=@FastXBetCashLK
CHANNEL_URL=https://t.me/FastXBetCashLK

# Dedicated Free Betting Tips channel ID (negative number for Telegram supergroups) and URL
TIPS_CHANNEL_ID=-1001234567890
TIPS_CHANNEL_URL=https://t.me/FastXBetTipsLK

# Admin alerts and notification channel ID
ADMIN_CHANNEL_ID=-1009876543210

# Official 1xBet registration affiliate link and promo code
XBET_LINK=https://reffpa.com/L?tag=d_12345m_97c_&site=12345&ad=97
XBET_PROMO_CODE=FASTLK

# Customer support contact numbers
WHATSAPP_NUMBER=+94770000000
EZCASH_NUMBER=0770000000
MCASH_NUMBER=0710000000
FRIMI_NUMBER=0760000000

# Banking deposit instructions displayed to users
BANK_DETAILS=Commercial Bank | A/C: 1234567890 | Name: XBet Cash Agent
DEPOSIT_INSTRUCTIONS=Please transfer the exact amount and upload the transaction receipt.

# Transaction boundaries (in LKR)
MIN_TRANSACTION_LKR=500
MAX_TRANSACTION_LKR=500000

# ------------------------------------------------------------------------------
# 4. Automated Sports Betting Tips Provider (The-Odds-API)
# ------------------------------------------------------------------------------
# Free/Paid API key from https://the-odds-api.com
ODDS_API_KEY=your_the_odds_api_key_here

# Sport keys to query (comma-separated, e.g. soccer_epl,soccer_uefa_champs_league)
TIPS_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,soccer_uefa_champs_league

# Minimum and maximum decimal odds for selected tips
TIPS_MIN_ODDS=1.40
TIPS_MAX_ODDS=2.80

# Number of betting picks to post per scheduled slot (default: 3)
TIPS_PER_SLOT=3

# Bookmaker regions (e.g. eu, uk, us, au)
TIPS_ODDS_REGIONS=eu

# Max hours ahead to fetch matches (default: 24)
TIPS_HOURS_AHEAD=24

# ------------------------------------------------------------------------------
# 5. Cloudflare R2 Object Storage (Audit Logs & Receipt Backups - Optional)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=xbet-receipts
R2_PUBLIC_DOMAIN=
